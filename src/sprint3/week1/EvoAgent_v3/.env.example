# Local server
EVOAGENT_V3_HOST=127.0.0.1
EVOAGENT_V3_PORT=8084
EVOAGENT_V3_DB_PATH=evoagent_v3.db

# GitHub: optional for public PR reads; required for private repositories and comments
EVOAGENT_V3_GITHUB_TOKEN=
EVOAGENT_V3_GITHUB_WEBHOOK_SECRET=replace-with-a-random-secret
EVOAGENT_V3_AUTO_POST_REVIEW=false

# Prefer the exact endpoint when your provider does not follow /v1/chat/completions
EVOAGENT_V3_LLM_CHAT_COMPLETIONS_URL=https://api.example.com/v1/chat/completions
# Or leave the exact URL empty and set a base URL:
# EVOAGENT_V3_LLM_BASE_URL=https://api.example.com/v1
EVOAGENT_V3_LLM_API_KEY=
EVOAGENT_V3_LLM_MODEL=
EVOAGENT_V3_TIMEOUT_SECONDS=120

# Limits
EVOAGENT_V3_MAX_REQUEST_BYTES=1048576
EVOAGENT_V3_MAX_DIFF_BYTES=900000
EVOAGENT_V3_WORKER_COUNT=2

# V3 bounded Agent Runtime
EVOAGENT_V3_AGENT_MAX_STEPS_PER_ROLE=4
EVOAGENT_V3_AGENT_MAX_CALLS=18
EVOAGENT_V3_AGENT_MAX_TOKENS=30000
EVOAGENT_V3_AGENT_TIMEOUT_SECONDS=240
