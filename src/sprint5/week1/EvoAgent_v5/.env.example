# HTTP 监听地址，默认只允许本机连接。
EVOAGENT_HOST=127.0.0.1
# HTTP 监听端口。
EVOAGENT_PORT=8080
# 未配置 PostgreSQL 时使用的 SQLite 文件路径。
EVOAGENT_DB_PATH=evoagent.db
# 单份 Diff 的 UTF-8 字节数上限。
EVOAGENT_MAX_DIFF_BYTES=1048576
# 工作流节点尝试次数上限，重试也消耗步数。
EVOAGENT_MAX_STEPS=8
# 审查运行时的总耗时预算，单位秒，也用于部分模型请求超时。
EVOAGENT_TIMEOUT_SECONDS=120

# Login is disabled by default for local use. Enable it before exposing the service.
# 是否要求登录；关闭时 HTTP 入口使用本地开发管理员身份。
EVOAGENT_AUTH_REQUIRED=false
# 登录令牌的签名密钥。
EVOAGENT_AUTH_SECRET=
# 启动时用于创建初始管理员的用户名。
EVOAGENT_BOOTSTRAP_ADMIN_USERNAME=
# 初始管理员密码；已有同名用户不会被覆盖密码。
EVOAGENT_BOOTSTRAP_ADMIN_PASSWORD=
# 未显式指定时使用的租户标识。
EVOAGENT_DEFAULT_TENANT_ID=default
# 登录令牌的有效时长，单位秒。
EVOAGENT_SESSION_TTL_SECONDS=3600

# LLM provider: local | deepseek | openrouter-deepseek-free | openrouter-free | custom
# local 不配置模型；服务可以启动，但当前 agentic 审查入口仍要求配置模型。
# 模型供应商预设；custom 使用下面的兼容接口配置。
EVOAGENT_LLM_PROVIDER=local

# 默认启用角色，逗号分隔；Lead 是协作审查必需角色。
EVOAGENT_ENABLED_AGENTS=lead,security,correctness-reliability,critic
# 单次角色循环的默认累计 Token 预算。
EVOAGENT_AGENT_TOKEN_BUDGET=8000
# 新任务使用保留原文的分批引擎。旧任务按创建时的引擎续跑。
EVOAGENT_REVIEW_BATCHING_ENABLED=true
# 整项审查的初始 Token 额度，耗尽后可追加额度续跑。
EVOAGENT_REVIEW_TASK_TOKEN_BUDGET=64000
# 单次角色循环的默认耗时预算，单位秒。
EVOAGENT_AGENT_TIME_BUDGET_SECONDS=60
# Preflight semantic context budget. Keep input + output below the model window.
# 模型上下文窗口总大小，输入和输出共同占用。
EVOAGENT_AGENT_CONTEXT_WINDOW_TOKENS=32768
# 上下文管理器的输入 Token 预算上限。
EVOAGENT_AGENT_CONTEXT_INPUT_TOKENS=20000
# 单批 Diff 的配置上限，分批引擎还会按角色、模型窗口和输入额度收紧。
EVOAGENT_CONTEXT_DIFF_TOKEN_BUDGET=12000
# 历史工具观察占用的目标 Token 预算。
EVOAGENT_CONTEXT_OBSERVATION_TOKEN_BUDGET=4000
# 优先保留详细内容的最近工具观察数量。
EVOAGENT_CONTEXT_RECENT_OBSERVATIONS=2
# Diff 块摘要分组时使用的 Token 预算。
EVOAGENT_CONTEXT_MAP_CHUNK_TOKENS=3000
# Configure current provider pricing for non-zero cost accounting in reports.
# 每百万输入 Token 单价，用于估算费用；零表示不计费估算。
EVOAGENT_LLM_INPUT_COST_PER_MILLION=0
# 每百万输出 Token 单价，币种应与输入单价一致。
EVOAGENT_LLM_OUTPUT_COST_PER_MILLION=0

# Official DeepSeek (paid API; model defaults to deepseek-v4-flash)
# DeepSeek 供应商使用的 API 密钥。
EVOAGENT_DEEPSEEK_API_KEY=

# OpenRouter free presets (API key required; low rate limits and availability may vary)
# OpenRouter 供应商使用的 API 密钥。
EVOAGENT_OPENROUTER_API_KEY=
# OpenRouter 请求中可选的站点来源信息。
EVOAGENT_OPENROUTER_SITE_URL=
# OpenRouter 请求中显示的应用名称。
EVOAGENT_OPENROUTER_APP_NAME=EvoAgent

# Custom OpenAI-compatible Chat Completions endpoint (all three are required)
# 兼容模型 API 的基础地址。
EVOAGENT_LLM_BASE_URL=
# 兼容模型 API 的访问密钥。
EVOAGENT_LLM_API_KEY=
# 模型标识；设置后可覆盖供应商默认模型。
EVOAGENT_LLM_MODEL=

# Replay evaluation and evolution activation gate
# 单次评测从每个数据划分读取的案例上限。
EVOAGENT_EVAL_MAX_CASES=5
# 允许候选激活所需的最少验证案例数。
EVOAGENT_EVAL_MIN_CASES=3
# 允许候选激活所需的最少独立保留案例数。
EVOAGENT_EVAL_MIN_HOLDOUT_CASES=2
# 候选相对基线需要达到的最小得分提升。
EVOAGENT_EVAL_MIN_IMPROVEMENT=0.01
# 受保护指标允许的最大退步，零表示不允许退步。
EVOAGENT_EVAL_MAX_METRIC_REGRESSION=0
# 支撑生产评测结论所需的最少公开真实 PR 数。
EVOAGENT_EVALUATION_MIN_PUBLIC_PRS=300
# 生产评测要求的最小 F1 提升阈值。
EVOAGENT_EVALUATION_MIN_F1_IMPROVEMENT=0.03
# 生产评测要求的高风险问题指标提升阈值。
EVOAGENT_EVALUATION_MIN_HIGH_RISK_IMPROVEMENT=0.05

# GitHub integration
# 校验 GitHub Webhook 原始请求体的 HMAC 密钥。
EVOAGENT_GITHUB_WEBHOOK_SECRET=
# 访问仓库、评论和修复提交所使用的 GitHub 令牌。
EVOAGENT_GITHUB_TOKEN=
# 审查完成后是否自动创建或更新 PR 报告评论。
EVOAGENT_AUTO_POST_REVIEW=false
# Webhook 时间校验允许的最大年龄，单位秒。
EVOAGENT_WEBHOOK_MAX_AGE_SECONDS=600

# Production persistence and queue. Leave blank for SQLite/in-process mode.
# PostgreSQL 连接串；留空时使用 SQLite。
EVOAGENT_DATABASE_URL=
# Redis 连接串；留空时使用进程内线程池队列。
EVOAGENT_REDIS_URL=
# 异步队列 Worker 数量。
EVOAGENT_ASYNC_WORKERS=2
# 任务投递总尝试次数，包含首次执行。
EVOAGENT_QUEUE_MAX_ATTEMPTS=3
# Redis 待处理消息被重新认领前的空闲时间，单位秒。
EVOAGENT_QUEUE_LEASE_SECONDS=60
# 扫描标准 Skill 包的目录。
EVOAGENT_SKILLS_DIR=skills

# Repair verification and observability
# 管理员配置的验证测试命令；空值表示未配置测试命令。
EVOAGENT_REPAIR_TEST_COMMAND=
# 修复验证命令的超时时间，单位秒。
EVOAGENT_REPAIR_VERIFY_TIMEOUT_SECONDS=120
# 是否启用审查记忆的持久化和召回。
EVOAGENT_MEMORY_ENABLED=true
# 每次默认返回的记忆条数。
EVOAGENT_MEMORY_RECALL_LIMIT=6
# 短期工作记忆的有效时长，单位秒。
EVOAGENT_MEMORY_WORKING_TTL_SECONDS=86400
# 可选的 OpenTelemetry 导出端点。
EVOAGENT_OTEL_ENDPOINT=
# 追踪系统中的服务名称。
EVOAGENT_OTEL_SERVICE_NAME=evoagent
# 任务失败率告警阈值，使用 0 到 1 的比例。
EVOAGENT_ALERT_FAILURE_RATE=0.20
# 计算失败率告警所需的最少任务样本数。
EVOAGENT_ALERT_MIN_SAMPLES=10

# GitHub App (installation flow: /github/install, callback: /github/setup)
# 可选 GitHub App 的应用标识。
EVOAGENT_GITHUB_APP_ID=
# GitHub App 安装入口使用的应用短名称。
EVOAGENT_GITHUB_APP_SLUG=
# GitHub App 签名私钥文件路径。
EVOAGENT_GITHUB_PRIVATE_KEY_PATH=
# 外部访问服务的基础地址，用于生成安装等回调链接。
EVOAGENT_PUBLIC_BASE_URL=http://127.0.0.1:8080
