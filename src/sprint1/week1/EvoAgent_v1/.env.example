# This project does not copy credentials from any other project.
PROMPT_REVIEW_HOST=127.0.0.1
PROMPT_REVIEW_PORT=8082
PROMPT_REVIEW_DB_PATH=prompt_review.db

# GitHub fine-grained PAT: repository metadata + pull requests read;
# add issues write only if automatic PR comments are enabled.
PROMPT_REVIEW_GITHUB_TOKEN=
PROMPT_REVIEW_GITHUB_WEBHOOK_SECRET=
PROMPT_REVIEW_AUTO_POST_REVIEW=false
# The public HTTPS base URL used when creating a GitHub Webhook.
PROMPT_REVIEW_PUBLIC_BASE_URL=http://127.0.0.1:8082

# Any OpenAI-compatible Chat Completions endpoint, including the configured MiMo endpoint.
PROMPT_REVIEW_LLM_BASE_URL=
PROMPT_REVIEW_LLM_API_KEY=
PROMPT_REVIEW_LLM_MODEL=
PROMPT_REVIEW_TIMEOUT_SECONDS=90
