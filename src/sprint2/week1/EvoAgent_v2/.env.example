# Local server
EVOAGENT_V2_HOST=127.0.0.1
EVOAGENT_V2_PORT=8083
EVOAGENT_V2_DB_PATH=evoagent_v2.db

# GitHub: optional for public PR reads; required for private repositories and comments
EVOAGENT_V2_GITHUB_TOKEN=
EVOAGENT_V2_GITHUB_WEBHOOK_SECRET=replace-with-a-random-secret
EVOAGENT_V2_AUTO_POST_REVIEW=false

# Prefer the exact endpoint when your provider does not follow /v1/chat/completions
EVOAGENT_V2_LLM_CHAT_COMPLETIONS_URL=https://api.example.com/v1/chat/completions
# Or leave the exact URL empty and set a base URL:
# EVOAGENT_V2_LLM_BASE_URL=https://api.example.com/v1
EVOAGENT_V2_LLM_API_KEY=
EVOAGENT_V2_LLM_MODEL=
EVOAGENT_V2_TIMEOUT_SECONDS=120

# Limits
EVOAGENT_V2_MAX_REQUEST_BYTES=1048576
EVOAGENT_V2_MAX_DIFF_BYTES=900000
EVOAGENT_V2_WORKER_COUNT=2
